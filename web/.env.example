# Admissible web surface — names only, no values.
# Every one of these is optional. With none of them set the server reads the
# recorded chain fixture and says "offline fixtures" on both pages.
# Copy to .env and fill in locally; .env is gitignored.

# Store to read. Default: web/.data/admissible-web.db, built by web/seed.py.
ADMISSIBLE_DB=

# Set this and the gate reads Base mainnet instead of the fixture, and the
# status chip turns green. Leave it empty for the zero-credential demo.
BASE_RPC_URL=

# A different recorded chain file. Default: web/fixtures/base-mainnet.json.
ADMISSIBLE_CHAIN_FIXTURE=

# The wallet this agent pays from. Without it the gate can confirm that a
# settlement involved the counterparty but not that it involved us, and a
# counterparty moving USDC between two addresses they own satisfies the
# weaker test. Defaults to the address recorded in the seed manifest.
ADMISSIBLE_SELF_ADDRESS=

# Deployment artefact for a published anchor, as JSON. Absent means the surface
# reports the root it computes and says plainly that nothing has been published.
ADMISSIBLE_ANCHOR_FILE=

# Pacing of the Server-Sent decision trace, in milliseconds. 0 turns it off.
ADMISSIBLE_TRACE_DELAY_MS=

# Landing links. Unset renders as unavailable rather than as an invented URL.
ADMISSIBLE_REPO_URL=
ADMISSIBLE_VIDEO_URL=

# The ACP bridge in workers/acp/ (pnpm serve). Without it the counterparty
# sourcing panel degrades to recorded values and says so.
ACP_WORKER_URL=
ACP_WORKER_TIMEOUT=

# Never put a private key in this file or in any file in this repository.
# admissible.chain reads PRIVATE_KEY from the environment and nowhere else,
# and the web surface never signs anything.
