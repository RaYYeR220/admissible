# Admissible -- environment.
#
# Names only. No value in this file is a secret and no secret belongs in it.
# Copy to .env (which is gitignored) and fill in locally, or export in your
# shell. Every one of these is OPTIONAL: `python scripts/demo.py` and
# `python scripts/eval.py` run to completion with this file absent, no keys set
# and no network, against the recorded chain fixtures in apps/fixtures/.

# ---------------------------------------------------------------------------
# Language model. Used only for the agent's advisory proposal and its narration,
# neither of which can reach the payment path (apps/agent/rails.py). With no key
# the agent runs a deterministic stub narrator and the decisions are identical.
# ---------------------------------------------------------------------------
VENICE_API_KEY=
# One of: qwen-3-8-max (default), z-ai-glm-5-3, gemini-3-8-flash
VENICE_MODEL=

# ---------------------------------------------------------------------------
# Chain. Needed only for `--live`, which swaps the recorded fixtures for a
# reader pointed at Base mainnet. The demo's default reads no network at all.
# ---------------------------------------------------------------------------
BASE_RPC=
BASE_SEPOLIA_RPC=

# ---------------------------------------------------------------------------
# Block explorer, for independently verifying a settlement by hand. Not read by
# anything under apps/ or scripts/.
# ---------------------------------------------------------------------------
ETHERSCAN_API_KEY=
