# Admissible -- environment.
#
# Names only. No value in this file is a secret and no secret belongs in it.
# Copy to .env (which is gitignored) and fill in locally, or export in your
# shell. Every one of these is OPTIONAL: `python bench/run.py`,
# `python scripts/demo.py`, `python scripts/eval.py` and `pytest` all run to
# completion with this file absent, no keys set and no network, against the
# recorded chain fixtures in apps/fixtures/.
#
# This is the list for the Python surfaces at the root of the repository:
# apps/, scripts/, packages/admissible and packages/admissible-mcp. Two other
# surfaces keep their own, and neither is duplicated here:
#   web/.env.example          the web server
#   workers/acp/.env.example  the Virtuals ACP worker (TypeScript)

# ---------------------------------------------------------------------------
# Language model. Used only for the agent's advisory proposal and its narration,
# neither of which can reach the payment path (apps/agent/rails.py). With no key
# the agent runs a deterministic stub narrator and the decisions are identical.
# ---------------------------------------------------------------------------

# Venice API key. Absent, apps/agent/narrator.py falls back to StubNarrator.
VENICE_API_KEY=
# Which Venice model to narrate with. One of: qwen-3-8-max (default),
# z-ai-glm-5-3, gemini-3-8-flash.
VENICE_MODEL=

# ---------------------------------------------------------------------------
# Chain. Reads only. Needed for `--live`, for `admissible verify`, and for the
# MCP server to be anything other than offline. The default demo path reads no
# network at all.
# ---------------------------------------------------------------------------

# Base mainnet JSON-RPC endpoint. This is the name every surface reads:
# admissible.cli, admissible-mcp, scripts/live_proof.py, apps/recorded_chain.py
# and the web server. Unset, live mode falls back to https://mainnet.base.org
# and the CLI verifies nothing rather than guessing.
BASE_RPC_URL=
# Deprecated alias, honoured only by apps/recorded_chain.py's live reader and
# only when BASE_RPC_URL is unset. Prefer BASE_RPC_URL.
BASE_RPC=
# Forces the MCP server to build a chain reader even with no RPC set, so a
# missing endpoint surfaces as chain_unreachable rather than as silence.
# Read by packages/admissible-mcp only.
ADMISSIBLE_CHAIN=

# ---------------------------------------------------------------------------
# Writes. Nothing in the default path reads these. Setting PRIVATE_KEY is the
# only way anything in this repository can sign, and it is read from the
# environment and nowhere else.
# ---------------------------------------------------------------------------

# Signing key for `admissible anchor --publish`, x402 settlement and
# scripts/live_proof.py --execute. Never commit it, never put it in a file here.
PRIVATE_KEY=
# Deployed AdmissibilityAnchor address, for `admissible anchor --publish` and
# for the anchoring step of scripts/live_proof.py.
ANCHOR_ADDRESS=
# A settlement transaction hash that has already been mined. Set it and
# scripts/live_proof.py reuses that payment instead of sending a new one, so the
# rest of the chain can be re-run without spending again.
SETTLEMENT_TX=

# ---------------------------------------------------------------------------
# Memory store. Both the CLI and the MCP server read these; ADMISSIBLE_DB wins
# over SIBYL_MEMORY_DB when both are set.
# ---------------------------------------------------------------------------

# Path to the Sibyl Memory SQLite database.
ADMISSIBLE_DB=
# Sibyl's own name for the same thing, honoured as a fallback.
SIBYL_MEMORY_DB=
# Tenant to scope every read and write to. Unset means Sibyl's default tenant.
SIBYL_TENANT_ID=
# The wallet this agent pays from. Without it the gate can confirm a settlement
# involved the counterparty but not that it involved us, and self-dealing
# (attack #3) satisfies the weaker test. Set it if you deploy this.
ADMISSIBLE_SELF_ADDRESS=
# Comma-separated memory categories to recall from, for a store that uses a
# different vocabulary. Unset means the built-in list.
ADMISSIBLE_CATEGORIES=

# ---------------------------------------------------------------------------
# Contracts and tooling.
# ---------------------------------------------------------------------------

# Etherscan V2 key, read by contracts/foundry.toml for `forge verify-contract`.
# One key covers Base mainnet and Base Sepolia. Nothing under apps/, scripts/ or
# packages/ reads it.
ETHERSCAN_API_KEY=
# Set to any value to strip ANSI colour from the admissible CLI's output.
NO_COLOR=
# Anvil endpoint and funded account for the opt-in contract integration tests in
# packages/admissible/tests/test_anchor.py. They are deselected by default; the
# defaults match a stock `anvil --port 8546`.
ANVIL_RPC=
ANVIL_KEY=
ANVIL_AGENT=
