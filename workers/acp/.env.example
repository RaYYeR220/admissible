# Chain to transact on. 84532 = Base Sepolia (default), 8453 = Base mainnet.
ACP_CHAIN_ID=84532

# Local bridge port the Python agent calls.
ACP_WORKER_PORT=8787

# Lifecycle events are appended here, one JSON object per line.
ACP_EVENT_LOG=events.jsonl

# Optional: our wallet, used only to report whether it maps to a registered agent.
ACP_WALLET_ADDRESS=

# Optional: path to the acp binary if it is not on PATH.
ACP_CLI_BIN=acp
